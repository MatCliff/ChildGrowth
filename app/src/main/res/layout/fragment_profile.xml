<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="viewModel"
            type="com.ubaya.childgrowth.viewmodel.ProfileViewModel" />
    </data>
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInutLayoutName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtInputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name"
                android:text="@={viewModel.userLD.name}"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/txtInputLayoutBirthdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtInputBirthdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Birth Date"
                android:focusable="false"
                android:clickable="true"
                android:text="@={viewModel.bodInput}"
                android:onClick="@{() -> viewModel.onDatePickerClicked()}"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/alatsi"
            android:text="Gender"
            android:textAlignment="viewStart"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">

            <RadioButton
                android:id="@+id/radioBtnMale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="@{viewModel.userLD.gender == 0}"
                android:onClick="@{() -> viewModel.setGender(0)}"
                android:text="Male" />

            <RadioButton
                android:id="@+id/radioBtnFemale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="@{viewModel.userLD.gender == 1}"
                android:onClick="@{() -> viewModel.setGender(1)}"
                android:text="Female" />
        </RadioGroup>

        <Button
            android:id="@+id/btnSaveProfile"
            android:backgroundTint="#2196F3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            app:cornerRadius="8dp"
            android:layout_marginEnd="20dp"
            android:text="Save"
            android:textColorLink="#288DEB"
            android:onClick="@{() -> viewModel.saveProfile()}"/>
    </LinearLayout>
</FrameLayout>
</layout>